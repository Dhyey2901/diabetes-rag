# ── Cloud LLM (OpenRouter — free at openrouter.ai) ───────────────────────────
# Set this to use OpenRouter instead of local Ollama (required for deployment)
OPENROUTER_API_KEY=

# Free model with no usage limits
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Local LLM (Ollama — used when GROQ_API_KEY is not set) ───────────────────
OLLAMA_MODEL=gemma:2b

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of retrieved chunks passed to the LLM as context
GEN_TOPK=4

# Retrieval confidence below which the system abstains (0–1)
CONF_ABSTAIN=0.35

# Lexical support overlap below which the generated answer is discarded (0–1)
SUPPORT_THRESHOLD=0.08

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
